# 1. AI Engine (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 2. Blockchain
RPC_URL=http://127.0.0.1:8545
# Path to the deployment file written by the contracts project's deploy script.
# Defaults to ../contracts/deployments/localhost.json if unset.
DEPLOYMENT_FILE=../contracts/deployments/localhost.json
# Private key of an address the contract owner has approved as an issuer
# (the local Hardhat deploy script approves the deployer automatically).
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 3. Server + simple API-key auth for the issuer-only routes
PORT=4000
ISSUER_API_KEY=dev-issuer-key
